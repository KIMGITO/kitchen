# Edge Function secrets. Never commit a real .env.
# Hosted:  supabase secrets set --env-file supabase/functions/.env
# Local:   supabase functions serve --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# ---------- M-Pesa: collecting payments (STK push) ----------
MPESA_ENV=sandbox                          # sandbox | production
MPESA_CONSUMER_KEY=                        # Daraja app
MPESA_CONSUMER_SECRET=                     # Daraja app
MPESA_SHORTCODE=174379                     # sandbox shortcode. Production: the shortcode Safaricom gave you for Lipa na M-Pesa Online (used for the password)
MPESA_PASSKEY=                             # sandbox passkey from the Daraja STK simulator; production passkey from Safaricom
MPESA_CALLBACK_SECRET=                     # long random string: `openssl rand -hex 32`. Protects callback + result URLs

# During rotation, keep the old value here so in-flight callbacks still verify, then remove it.
# MPESA_CALLBACK_SECRET_PREVIOUS=

# Till (Buy Goods) collections - production:
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # set to CustomerBuyGoodsOnline for a Till
# MPESA_PARTY_B=                                # your TILL NUMBER (the account that receives the money)

# ---------- M-Pesa: payouts (B2C) and refunds (Reversal) ----------
# The initiator is the API user created on the M-Pesa portal for your business.
MPESA_INITIATOR_NAME=
# Initiator password encrypted with Safaricom's public certificate, base64. Generate it once - see README "Security credential".
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_SHORTCODE=                       # the shortcode funded for B2C payouts (sandbox: 600000-series shortcode from the portal)
# MPESA_REVERSAL_RECEIVER=                 # defaults to MPESA_PARTY_B (till) or MPESA_SHORTCODE: the account that received customer payments

# ---------- Notifications ----------
RESEND_API_KEY=                            # email
EMAIL_FROM="Your Platform <no-reply@yourdomain.com>"
AT_API_KEY=                                # Africa's Talking (SMS)
AT_USERNAME=                               # "sandbox" in the Africa's Talking sandbox
# AT_ENV=production                        # or sandbox
# AT_SENDER_ID=                            # approved alphanumeric sender id (optional)

# ---------- Local testing only ----------
# MPESA_CALLBACK_BASE_URL=https://<your-tunnel>.ngrok.app/functions/v1   # public URL Safaricom can reach
