{
  // Cloudflare Worker for the Next.js app (built by `opennextjs-cloudflare build`, deployed by `wrangler deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker name in the Cloudflare dashboard (Workers & Pages > your Worker), or Workers Builds will refuse to deploy.
  "name": "kitchen",
  "main": ".open-next/worker.js",

  // nodejs_compat is required by Next.js/OpenNext. A date of 2025-04-01 or later also fills `process.env` from your secrets and variables.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Keep variables/secrets that you set in the dashboard when deploying from CI.
  "keep_vars": true,
  "observability": { "enabled": true },

  // Route every host under the platform root domain to this Worker (see README §11b "Domains").
  // Workers *custom domains* can't match a wildcard, but *routes* can, so:
  //   interlockingblockbuilders.co.ke            -> platform marketing / onboarding   (root -> /platform)
  //   admin.interlockingblockbuilders.co.ke      -> platform admin console           (admin.<root> -> /platform-admin)
  //   <slug>.interlockingblockbuilders.co.ke     -> a kitchen storefront, resolved by hostname server-side
  // Requires the zone interlockingblockbuilders.co.ke to be on THIS Cloudflare account, plus a proxied
  // wildcard DNS record ( * -> AAAA 100:: placeholder ) and the apex. `wrangler deploy` fails with
  // "zone not found" until the zone is added, so add the zone/DNS first, then deploy.
  "routes": [
    { "pattern": "interlockingblockbuilders.co.ke/*",   "zone_name": "interlockingblockbuilders.co.ke" },
    { "pattern": "*.interlockingblockbuilders.co.ke/*", "zone_name": "interlockingblockbuilders.co.ke" }
  ]
}
