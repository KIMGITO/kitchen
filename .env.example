# Copy to .env.local (never commit real values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ROOT_DOMAIN=localhost          # must equal platform_settings.root_domain in the database
NEXT_PUBLIC_SUPABASE_TRANSFORMS=false      # true only if Supabase image transformations are enabled

# Server only
SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_OWNER_EMAIL=                      # set BEFORE first deploy so only this email can claim /setup
RESEND_API_KEY=
EMAIL_FROM="Your Platform <no-reply@yourdomain.com>"
